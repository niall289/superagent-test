---
interface Props {
  id: 'warehouse' | 'georgian' | 'cold-store'
  alt: string
  caption: string
  index: number
}

const { id, alt, caption, index } = Astro.props

const sheets: Record<Props['id'], string> = {
  warehouse: 'E-204 / Racking & lighting',
  georgian: 'E-117 / Window bay',
  'cold-store': 'E-302 / Supply & submains',
}

const titleId = `project-plate-${index}-title`
const descId = `project-plate-${index}-desc`
---

<div class="plate">
  <div class="plate__head">
    <span class="meta">{sheets[id]}</span>
    <span class="meta">Plate {String(index).padStart(2, '0')}</span>
  </div>

  <svg class="plate__svg" viewBox="0 0 400 300" role="img" aria-labelledby={`${titleId} ${descId}`}>
    <title id={titleId}>Technical plate for {caption}</title>
    <desc id={descId}>{alt}</desc>

    <line class="line-soft" x1="20" y1="30" x2="380" y2="30"></line>
    <line class="line-soft" x1="20" y1="270" x2="380" y2="270"></line>
    <line class="line-soft" x1="20" y1="30" x2="20" y2="270"></line>
    <line class="line-soft" x1="380" y1="30" x2="380" y2="270"></line>

    {id === 'warehouse' && (
      <g>
        <text x="32" y="46">PLAN / RACKING &amp; LIGHTING</text>
        <text x="368" y="46" text-anchor="end" class="text-faint">1:200</text>

        <rect class="line-soft" x="56" y="74" width="200" height="16"></rect>
        <rect class="line-soft" x="56" y="118" width="200" height="16"></rect>
        <rect class="line-soft" x="56" y="162" width="200" height="16"></rect>
        <text x="64" y="85" class="text-faint">RACK A</text>
        <text x="64" y="129" class="text-faint">RACK B</text>
        <text x="64" y="173" class="text-faint">RACK C</text>

        {[80, 116, 152, 188, 224].map((x) =>
          [102, 146, 190].map((y) => <rect class="fill-accent" x={x} y={y} width="3" height="3"></rect>),
        )}

        <rect class="fill-surface" x="292" y="74" width="56" height="34"></rect>
        <text x="320" y="94" text-anchor="middle">DB-2</text>
        <line class="accent" x1="292" y1="91" x2="256" y2="91"></line>
        <line class="accent" x1="256" y1="91" x2="256" y2="200"></line>
        <line class="accent" x1="256" y1="200" x2="60" y2="200"></line>

        <line class="line" x1="56" y1="236" x2="256" y2="236"></line>
        <line class="line" x1="56" y1="230" x2="56" y2="242"></line>
        <line class="line" x1="256" y1="230" x2="256" y2="242"></line>
        <text x="156" y="228" text-anchor="middle" class="text-faint">1,850 m² · 96 LUMINAIRES</text>

        <g>
          <line class="line" x1="340" y1="196" x2="340" y2="236"></line>
          <path class="fill-accent" d="M340 190l-5 10h10z"></path>
          <text x="340" y="252" text-anchor="middle" class="text-faint">N</text>
        </g>
      </g>
    )}

    {id === 'georgian' && (
      <g>
        <text x="32" y="46">ELEVATION / WINDOW BAY</text>
        <text x="368" y="46" text-anchor="end" class="text-faint">1:50</text>

        <line class="line" x1="62" y1="58" x2="338" y2="58"></line>
        <line class="line-soft" x1="70" y1="64" x2="330" y2="64"></line>
        <text x="32" y="76" class="text-faint">CORNICE RETAINED</text>

        <rect class="line-soft" x="88" y="82" width="224" height="150"></rect>
        <rect class="line" x="108" y="96" width="184" height="122"></rect>
        <line class="line-soft" x1="200" y1="96" x2="200" y2="218"></line>
        <line class="line-soft" x1="108" y1="137" x2="292" y2="137"></line>
        <line class="line-soft" x1="108" y1="178" x2="292" y2="178"></line>

        <rect class="fill-surface" x="70" y="96" width="18" height="122"></rect>
        <rect class="fill-surface" x="312" y="96" width="18" height="122"></rect>

        <path class="dash" d="M126 96v58h-44v70"></path>
        <rect class="fill-surface" x="70" y="224" width="80" height="10"></rect>
        <text x="70" y="250" class="text-faint">BRASS TRUNKING</text>
        <text x="230" y="250" class="text-faint">SINGLES IN VOID</text>

        <line class="accent" x1="108" y1="96" x2="108" y2="154"></line>
        <circle class="fill-accent" cx="108" cy="96" r="3"></circle>

        <line class="line" x1="88" y1="258" x2="312" y2="258"></line>
        <line class="line" x1="88" y1="252" x2="88" y2="264"></line>
        <line class="line" x1="312" y1="252" x2="312" y2="264"></line>
        <text x="200" y="254" text-anchor="middle" class="text-faint">6.2 m BAY</text>
      </g>
    )}

    {id === 'cold-store' && (
      <g>
        <text x="32" y="46">SINGLE LINE / SUPPLY &amp; SUBMAINS</text>
        <text x="368" y="46" text-anchor="end" class="text-faint">REV B · 2023</text>

        <rect class="fill-surface" x="32" y="70" width="64" height="34"></rect>
        <text x="64" y="90" text-anchor="middle">ESB 400 A</text>
        <line class="accent" x1="96" y1="87" x2="132" y2="87"></line>
        <rect class="fill-surface" x="132" y="70" width="44" height="34"></rect>
        <text x="154" y="90" text-anchor="middle">METER</text>
        <line class="accent" x1="176" y1="87" x2="208" y2="87"></line>
        <path class="line" d="M208 80v14M204 84l8 6"></path>
        <text x="216" y="84" class="text-faint">MAIN SWITCH</text>

        <line class="accent" x1="208" y1="120" x2="368" y2="120"></line>
        <line class="accent" x1="208" y1="87" x2="208" y2="120"></line>
        <text x="368" y="112" text-anchor="end" class="text-faint">BUS A · 400 A</text>

        {[220, 246, 272, 298, 324, 350].map((x, room) => (
          <g>
            <line class="line" x1={x} y1="120" x2={x} y2="160"></line>
            <path class="line" d={`M${x - 5} 154l10 5`}></path>
            <rect class="fill-surface" x={x - 11} y="160" width="22" height="28"></rect>
            <text x={x} y="178" text-anchor="middle">FR-{room + 1}</text>
            <text x={x} y="202" text-anchor="middle" class="text-accent">−25°</text>
          </g>
        ))}

        <line class="dash" x1="208" y1="232" x2="368" y2="232"></line>
        <rect class="line-soft" x="208" y="220" width="52" height="24"></rect>
        <text x="234" y="235" text-anchor="middle" class="text-faint">STANDBY</text>
        <text x="368" y="226" text-anchor="end" class="text-faint">CHANGEOVER</text>

        <line class="line" x1="220" y1="256" x2="350" y2="256"></line>
        <line class="line" x1="220" y1="250" x2="220" y2="262"></line>
        <line class="line" x1="350" y1="250" x2="350" y2="262"></line>
        <text x="285" y="254" text-anchor="middle" class="text-faint">6 SUBMAINS · MONITORED</text>
      </g>
    )}
  </svg>

  <p class="plate__caption">{caption}</p>
</div>

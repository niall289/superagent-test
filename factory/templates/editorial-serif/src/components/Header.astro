---
import type { SiteData } from '../lib/content'

interface Props {
  site: SiteData
}

const { site } = Astro.props
const menuId = 'site-menu'
---

<header class="site-header">
  <div class="container header__inner">
    <a class="wordmark" href="/" aria-label={`${site.name} — home`}>
      <span class="wordmark__mark" aria-hidden="true">K</span>
      <span>
        <span class="wordmark__name">{site.name}</span>
        <span class="wordmark__role">{site.tagline}</span>
      </span>
    </a>

    <nav class="header__nav" aria-label="Primary">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header__actions">
      <a class="btn btn--ghost header__phone" href={`tel:${site.phoneHref}`}>
        <span aria-hidden="true">Call</span>
        <span>{site.phone}</span>
      </a>
      <button
        class="icon-btn menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls={menuId}
        data-menu-open
      >
        <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true" focusable="false">
          <path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.25"></path>
        </svg>
        Menu
      </button>
    </div>
  </div>
</header>

<dialog id={menuId} class="drawer" aria-label="Site menu" data-menu>
  <div class="drawer__inner">
    <div class="drawer__head">
      <a class="wordmark" href="/" aria-label={`${site.name} — home`}>
        <span class="wordmark__mark" aria-hidden="true">K</span>
        <span class="wordmark__name">{site.name}</span>
      </a>
      <button class="icon-btn" type="button" data-menu-close>
        Close
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
          <path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.25"></path>
        </svg>
      </button>
    </div>

    <nav class="drawer__nav" aria-label="Mobile">
      {site.nav.map((item, index) => (
        <a href={item.href}>
          {item.label}
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        </a>
      ))}
    </nav>

    <div class="drawer__foot">
      <p class="meta">Live fault or loss of supply</p>
      <a class="contact__phone" href={`tel:${site.emergencyPhoneHref}`}>{site.emergencyPhone}</a>
      <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]')
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]')
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]')
  const desktop = window.matchMedia('(min-width: 64em)')

  if (dialog && openButton && closeButton) {
    const lock = (locked: boolean) => {
      document.documentElement.classList.toggle('is-locked', locked)
    }

    openButton.addEventListener('click', () => {
      dialog.showModal()
      openButton.setAttribute('aria-expanded', 'true')
      lock(true)
      closeButton.focus()
    })

    dialog.addEventListener('close', () => {
      openButton.setAttribute('aria-expanded', 'false')
      lock(false)
      openButton.focus()
    })

    closeButton.addEventListener('click', () => dialog.close())

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close()
    })

    dialog.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => dialog.close())
    })

    desktop.addEventListener('change', (event) => {
      if (event.matches && dialog.open) dialog.close()
    })
  }
</script>

---
import type { ProjectData } from '../lib/content'
import ProjectPlate from './plates/ProjectPlate.astro'

interface Props {
  projects: ProjectData[]
}

const { projects } = Astro.props
---

<section id="work" class="section" aria-labelledby="work-title">
  <div class="container">
    <div class="section-head" data-motion="reveal">
      <p class="eyebrow">02 — Selected work</p>
      <div class="section-head__row">
        <h2 id="work-title" class="section-title">Work that had to stay live.</h2>
        <p class="lede projects__intro">
          Three recent jobs where the building could not close, the supply could not drop, or the
          fabric could not be touched.
        </p>
      </div>
    </div>

    <div class="projects__list">
      {projects.map((project, index) => (
        <article class="project" data-motion="reveal" aria-labelledby={`project-${index}-title`}>
          <div class="project__content">
            <div class="project__head">
              <h3 id={`project-${index}-title`} class="project__title">{project.title}</h3>
              <p class="project__meta">
                {project.sector} · {project.location} · {project.year}
              </p>
            </div>
            <p class="project__summary">{project.summary}</p>

            <dl class="project__notes">
              <div class="project__note">
                <dt>Brief</dt>
                <dd>{project.brief}</dd>
              </div>
              <div class="project__note">
                <dt>What we did</dt>
                <dd>{project.outcome}</dd>
              </div>
            </dl>

            <dl class="specs">
              {project.specs.map((spec) => (
                <div class="specs__row">
                  <dt>{spec.label}</dt>
                  <dd>{spec.value}</dd>
                </div>
              ))}
            </dl>
          </div>

          <figure class="project__plate">
            <ProjectPlate
              id={project.plate.id}
              alt={project.plate.alt}
              caption={project.plate.caption}
              index={index + 1}
            />
          </figure>
        </article>
      ))}
    </div>
  </div>
</section>

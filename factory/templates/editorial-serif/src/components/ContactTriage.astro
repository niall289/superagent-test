---
import type { SiteData } from '../lib/content'

interface Props {
  site: SiteData
}

const { site } = Astro.props
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container contact__grid">
    <div class="contact__intro" data-motion="reveal">
      <p class="eyebrow">03 — Contact</p>
      <h2 id="contact-title" class="section-title">Tell us what the building needs.</h2>
      <p class="lede">
        Send the address, the type of work and the deadline. We reply within one working day with
        a site visit date or a clear referral if the job is not ours.
      </p>

      <div class="contact__call">
        <p class="meta">Live fault or loss of supply</p>
        <a class="contact__phone" href={`tel:${site.emergencyPhoneHref}`}>{site.emergencyPhone}</a>
        <p class="body-copy">
          Answered 24 hours. For planned work, use the form — it reaches the estimating desk, not
          the call-out phone.
        </p>
      </div>

      <dl class="contact__hours">
        {site.hours.map((entry) => (
          <div>
            <dt>{entry.days}</dt>
            <dd>{entry.hours}</dd>
          </div>
        ))}
      </dl>

      <p class="body-copy">
        Or email <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </div>

    <form
      class="form"
      action="#contact"
      method="get"
      novalidate
      data-enquiry-form
      data-endpoint=""
      data-phone={site.emergencyPhone}
      data-email={site.email}
    >
      <p class="meta">Enquiry form</p>

      <div class="form__row form__row--split">
        <div class="field" data-field>
          <label for="enquiry-name">Name</label>
          <input
            id="enquiry-name"
            name="name"
            type="text"
            autocomplete="name"
            required
            aria-describedby="enquiry-name-error"
          />
          <p class="field__error" id="enquiry-name-error" data-error></p>
        </div>

        <div class="field" data-field>
          <label for="enquiry-phone">Phone</label>
          <input
            id="enquiry-phone"
            name="phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            required
            aria-describedby="enquiry-phone-error"
          />
          <p class="field__error" id="enquiry-phone-error" data-error></p>
        </div>
      </div>

      <div class="form__row form__row--split">
        <div class="field" data-field>
          <label for="enquiry-email">Email</label>
          <input
            id="enquiry-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            aria-describedby="enquiry-email-error"
          />
          <p class="field__error" id="enquiry-email-error" data-error></p>
        </div>

        <div class="field" data-field>
          <label for="enquiry-type">Type of work</label>
          <select
            id="enquiry-type"
            name="workType"
            required
            aria-describedby="enquiry-type-error"
          >
            <option value="">Choose one</option>
            <option value="fit-out">Commercial fit-out</option>
            <option value="distribution">Distribution or switchgear</option>
            <option value="emergency-lighting">Emergency lighting or fire alarm</option>
            <option value="testing">Testing, certification or maintenance</option>
            <option value="fault">Live fault or loss of supply</option>
          </select>
          <p class="field__error" id="enquiry-type-error" data-error></p>
        </div>
      </div>

      <div class="field" data-field>
        <label for="enquiry-address">Site address</label>
        <input
          id="enquiry-address"
          name="siteAddress"
          type="text"
          autocomplete="street-address"
          required
          aria-describedby="enquiry-address-error"
        />
        <p class="field__error" id="enquiry-address-error" data-error></p>
      </div>

      <div class="field" data-field>
        <label for="enquiry-message">What is happening?</label>
        <textarea
          id="enquiry-message"
          name="message"
          rows="4"
          required
          aria-describedby="enquiry-message-hint enquiry-message-error"
        ></textarea>
        <p class="field__hint" id="enquiry-message-hint">
          Building size, access restrictions, the deadline and anything that cannot be switched
          off.
        </p>
        <p class="field__error" id="enquiry-message-error" data-error></p>
      </div>

      <label class="checkbox" data-field>
        <input type="checkbox" name="consent" value="yes" required aria-describedby="enquiry-consent-error" />
        <span>
          I am happy for Kilbride Electrical to reply to this enquiry. See the
          <a href={site.legal.privacyPath}>privacy notice</a>.
        </span>
      </label>
      <p class="field__error" id="enquiry-consent-error" data-error></p>

      <button class="btn btn--primary" type="submit">Send enquiry</button>
      <p class="field__hint">
        This form sends a summary to the estimating desk. For a live fault, call
        {' '}<a class="text-link" href={`tel:${site.emergencyPhoneHref}`}>{site.emergencyPhone}</a>.
      </p>

      <div class="form__status" role="status" aria-live="polite" hidden data-status></div>

      <noscript>
        <p class="form__status">
          JavaScript is off, so this form cannot validate. Email
          <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
          or call <a class="text-link" href={`tel:${site.phoneHref}`}>{site.phone}</a>.
        </p>
      </noscript>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-enquiry-form]')

  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')
    const phone = form.dataset.phone ?? ''
    const email = form.dataset.email ?? ''

    type Rule = (value: string) => string

    const rules: Record<string, Rule> = {
      name: (value) => (value.trim().length >= 2 ? '' : 'Add the name we should ask for.'),
      phone: (value) =>
        value.replace(/[^0-9+]/g, '').length >= 7 ? '' : 'Add a number we can reach you on.',
      email: (value) =>
        /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value.trim()) ? '' : 'Add an email address for the reply.',
      workType: (value) => (value ? '' : 'Choose the kind of work.'),
      siteAddress: (value) =>
        value.trim().length >= 5 ? '' : 'Add the address or Eircode of the building.',
      message: (value) =>
        value.trim().length >= 10 ? '' : 'Tell us what is happening, even in one sentence.',
      consent: (value) => (value ? '' : 'Confirm we can reply to this enquiry.'),
    }

    const fieldFor = (name: string): HTMLElement | null => {
      const input = form.elements.namedItem(name)
      if (!(input instanceof HTMLInputElement || input instanceof HTMLSelectElement || input instanceof HTMLTextAreaElement)) {
        return null
      }
      return input.closest<HTMLElement>('[data-field]')
    }

    const errorIds: Record<string, string> = {
      name: 'enquiry-name-error',
      phone: 'enquiry-phone-error',
      email: 'enquiry-email-error',
      workType: 'enquiry-type-error',
      siteAddress: 'enquiry-address-error',
      message: 'enquiry-message-error',
      consent: 'enquiry-consent-error',
    }

    const showError = (name: string, message: string) => {
      const field = fieldFor(name)
      const error = form.querySelector<HTMLElement>(`#${errorIds[name]}`)
      const input = form.elements.namedItem(name)
      if (field) field.dataset.invalid = message ? 'true' : 'false'
      if (error) error.textContent = message
      if (input instanceof HTMLElement) {
        if (message) input.setAttribute('aria-invalid', 'true')
        else input.removeAttribute('aria-invalid')
      }
    }

    const validate = (): boolean => {
      let firstInvalid: HTMLElement | null = null

      for (const [name, rule] of Object.entries(rules)) {
        const input = form.elements.namedItem(name)
        if (!(input instanceof HTMLInputElement || input instanceof HTMLSelectElement || input instanceof HTMLTextAreaElement)) {
          continue
        }
        const value = input instanceof HTMLInputElement && input.type === 'checkbox'
          ? input.checked ? 'yes' : ''
          : input.value
        const message = rule(value)
        showError(name, message)
        if (message && !firstInvalid) firstInvalid = input
      }

      if (firstInvalid) {
        firstInvalid.focus()
        if (status) {
          status.hidden = false
          status.dataset.tone = 'error'
          status.textContent = 'Check the highlighted fields and send again.'
        }
        return false
      }

      return true
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!validate() || !status || !submit) return

      const endpoint = form.dataset.endpoint?.trim()
      const fallback = `Enquiry captured in this demo form. Connect an endpoint in ContactTriage.astro before launch, or call ${phone}.`

      submit.disabled = true
      status.hidden = false
      status.dataset.tone = ''
      status.textContent = 'Sending…'

      try {
        if (endpoint) {
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          })
          if (!response.ok) throw new Error(`HTTP ${response.status}`)
          status.dataset.tone = 'success'
          status.textContent = 'Enquiry received. We reply within one working day. For a live fault, call ' + phone + '.'
        } else {
          status.dataset.tone = 'success'
          status.textContent = fallback
        }
        form.reset()
        for (const name of Object.keys(rules)) showError(name, '')
      } catch {
        status.dataset.tone = 'error'
        status.textContent = 'The form could not send. Call ' + phone + ' or email ' + email + ' instead.'
      } finally {
        submit.disabled = false
      }
    })
  }
</script>

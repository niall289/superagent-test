{
  "name": "editorial-serif",
  "version": "0.1.0",
  "private": true,
  "description": "Editorial / commercial trade template: Astro 5, TypeScript, Tailwind 4, Lenis and GSAP, pinned to @factory/tokens.",
  "type": "module",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=12.16.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "check": "astro check && astro build && node scripts/check-links.mjs"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.2.5",
    "astro": "^5.18.2",
    "gsap": "^3.13.0",
    "lenis": "^1.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.6.0",
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0"
  }
}

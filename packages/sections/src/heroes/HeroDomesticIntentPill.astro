---
export interface Props {
  headline: string;
  subheading: string;
  emergencyPhone?: string;
  serviceArea?: string;
  serviceChips?: Array<{
    id: string;
    label: string;
    popular?: boolean;
  }>;
  bookingUrl?: string;
  ctaLabel?: string;
  ratingScore?: string;
  ratingCount?: string;
  ratingSource?: string;
  ratingEvidence?: string;
  registrationNumber?: string;
  registrationScheme?: string;
  uspItems?: Array<{
    label: string;
    sublabel?: string;
  }>;
  backgroundImage?: string;
}

const {
  headline = "Reliable Local Plumbing & Heating. On Your Doorstep.",
  subheading = "Emergency leak repairs, boiler breakdowns, pipe unblocking, and central heating installations across your area.",
  emergencyPhone = "020 7924 3840",
  serviceArea = "London & Surrounding M25",
  serviceChips = [
    { id: "leaks", label: "Leaks & Burst Pipes", popular: true },
    { id: "boiler", label: "Boiler Breakdown & Service", popular: true },
    { id: "drains", label: "Blocked Drains" },
    { id: "heating", label: "Radiators & Heating" },
    { id: "bathrooms", label: "Taps & Toilets" },
    { id: "other", label: "General Plumbing" }
  ],
  bookingUrl = "#booking-enquiry",
  ctaLabel = "Book a Visit",
  ratingScore = "4.9",
  ratingCount = "3,400+ reviews",
  ratingSource = "Trustpilot",
  ratingEvidence = "Trustpilot|2026-10",
  registrationNumber = "619284",
  registrationScheme = "Gas Safe Register",
  uspItems = [
    { label: "Rapid Attendance", sublabel: "Target 60-90m emergency dispatch" },
    { label: "Direct Phone Line", sublabel: "Speak with an on-call engineer" },
    { label: "Clear Fixed Pricing", sublabel: "Itemised quote before work starts" },
    { label: "12-Month Guarantee", sublabel: "All parts & labour fully insured" }
  ],
  backgroundImage = ""
} = Astro.props;
---

<section class="domestic-hero" aria-labelledby="hero-heading">
  <div class="domestic-hero__backdrop" style={backgroundImage ? `background-image: url('${backgroundImage}')` : undefined}>
    <div class="domestic-hero__overlay" aria-hidden="true"></div>
  </div>

  <div class="domestic-hero__container">
    <div class="domestic-hero__content">
      {ratingScore && (
        <div class="domestic-hero__trust-strip" data-evidence={ratingEvidence}>
          <div class="domestic-hero__stars" aria-hidden="true">
            <svg class="star-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            <span class="domestic-hero__score">{ratingScore} / 5</span>
          </div>
          <span class="domestic-hero__rating-meta">
            <strong>{ratingSource}</strong> ({ratingCount})
          </span>
          {registrationNumber && (
            <span class="domestic-hero__reg-badge" title={`Verified with ${registrationScheme}`}>
              {registrationScheme} #{registrationNumber}
            </span>
          )}
        </div>
      )}

      <h1 id="hero-heading" class="domestic-hero__heading">{headline}</h1>
      <p class="domestic-hero__subheading">{subheading}</p>

      <!-- Fast-Intent Pre-Qualify Chips -->
      <form class="domestic-hero__intent-box" action={bookingUrl} method="GET">
        <fieldset class="intent-fieldset">
          <legend class="intent-legend">I need help with:</legend>
          <div class="intent-chips-grid" role="radiogroup" aria-label="Select plumbing or heating service">
            {serviceChips.map((chip, idx) => (
              <label class="intent-chip">
                <input
                  type="radio"
                  name="service"
                  value={chip.id}
                  class="intent-chip__input"
                  checked={idx === 0}
                />
                <span class="intent-chip__surface">
                  <span class="intent-chip__dot" aria-hidden="true"></span>
                  <span class="intent-chip__text">{chip.label}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="intent-actions">
          <button type="submit" class="btn btn--primary hero-submit-btn">
            <span>{ctaLabel}</span>
            <svg class="btn-arrow" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
          <span class="intent-coverage-hint">Covering {serviceArea}</span>
        </div>
      </form>

      {emergencyPhone && (
        <div class="domestic-hero__dispatch-note">
          <span class="dispatch-pulse" aria-hidden="true"></span>
          <span class="dispatch-text">
            Immediate emergency? Speak directly with dispatch: <a href={`tel:${emergencyPhone.replace(/\s+/g, '')}`} class="dispatch-phone">{emergencyPhone}</a>
          </span>
        </div>
      )}
    </div>
  </div>

  <div class="domestic-hero__usp-bar">
    <div class="domestic-hero__container">
      <ul class="usp-grid" role="list">
        {uspItems.map((usp) => (
          <li class="usp-item">
            <div class="usp-item__icon-wrap" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="8 12 11 15 16 9"></polyline>
              </svg>
            </div>
            <div class="usp-item__text-wrap">
              <strong class="usp-item__label">{usp.label}</strong>
              {usp.sublabel && <span class="usp-item__sublabel">{usp.sublabel}</span>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .domestic-hero {
    position: relative;
    width: 100%;
    background-color: var(--canvas);
    color: var(--text-1);
    overflow: hidden;
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--hairline);
  }

  .domestic-hero__backdrop {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.16;
    pointer-events: none;
    z-index: var(--z-base);
  }

  .domestic-hero__overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 80% 20%, rgba(212, 167, 44, 0.05), transparent 70%);
    pointer-events: none;
  }

  .domestic-hero__container {
    max-width: var(--content-max);
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--gutter-mobile);
    padding-right: var(--gutter-mobile);
    position: relative;
    z-index: var(--z-raised);
  }

  @media (min-width: 768px) {
    .domestic-hero__container {
      padding-left: var(--gutter-tablet);
      padding-right: var(--gutter-tablet);
    }
  }

  @media (min-width: 1024px) {
    .domestic-hero__container {
      padding-left: var(--gutter-desktop);
      padding-right: var(--gutter-desktop);
    }
  }

  .domestic-hero__content {
    max-width: 780px;
    padding-bottom: clamp(2rem, 3.5vw, 3.5rem);
  }

  .domestic-hero__trust-strip {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 12px;
    background-color: var(--surface-1);
    border: 1px solid var(--hairline);
    border-radius: var(--r-sm);
    font-size: var(--text-sm);
    color: var(--text-2);
    margin-bottom: var(--space-4);
  }

  .domestic-hero__stars {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--ok);
  }

  .domestic-hero__score {
    font-weight: var(--weight-semibold);
    font-variant-numeric: var(--font-variant-numeric-tabular);
    color: var(--text-1);
  }

  .domestic-hero__rating-meta {
    border-left: 1px solid var(--hairline);
    padding-left: var(--space-2);
    font-size: 0.8125rem;
  }

  .domestic-hero__reg-badge {
    border-left: 1px solid var(--hairline);
    padding-left: var(--space-2);
    font-size: 0.8125rem;
    color: var(--accent);
    font-variant-numeric: var(--font-variant-numeric-tabular);
  }

  .domestic-hero__heading {
    font-size: var(--text-display);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    color: var(--text-1);
    margin: 0 0 var(--space-4) 0;
    max-width: 22ch;
  }

  .domestic-hero__subheading {
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--text-2);
    margin: 0 0 var(--space-6) 0;
    max-width: var(--measure);
  }

  /* Intent Chip Fieldset */
  .domestic-hero__intent-box {
    background-color: var(--surface-1);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    padding: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .intent-fieldset {
    border: none;
    margin: 0;
    padding: 0;
  }

  .intent-legend {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-2);
    margin-bottom: var(--space-3);
  }

  .intent-chips-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .intent-chip {
    cursor: pointer;
    position: relative;
    user-select: none;
  }

  .intent-chip__input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .intent-chip__surface {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 8px 14px;
    background-color: var(--surface-2);
    border: 1px solid var(--hairline);
    border-radius: var(--r-sm);
    font-size: var(--text-sm);
    color: var(--text-2);
    transition: border-color var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }

  .intent-chip__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--hairline);
    flex-shrink: 0;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .intent-chip__input:checked + .intent-chip__surface {
    border-color: var(--accent);
    background-color: var(--surface-1);
    color: var(--text-1);
  }

  .intent-chip__input:checked + .intent-chip__surface .intent-chip__dot {
    background-color: var(--accent);
  }

  .intent-chip__input:focus-visible + .intent-chip__surface {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .intent-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--hairline);
  }

  @media (min-width: 640px) {
    .intent-actions {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .hero-submit-btn {
    min-height: 48px;
    padding: 0 var(--space-6);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background-color: var(--accent);
    color: #121215;
    font-weight: var(--weight-medium);
    font-size: var(--text-base);
    border-radius: var(--r-sm);
    border: none;
    cursor: pointer;
    transition: opacity var(--duration-fast) var(--ease-standard), transform var(--duration-fast) var(--ease-standard);
  }

  .hero-submit-btn:active {
    transform: scale(0.98);
  }

  .hero-submit-btn:hover {
    opacity: 0.94;
  }

  .intent-coverage-hint {
    font-size: var(--text-sm);
    color: var(--text-3);
  }

  .domestic-hero__dispatch-note {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-3);
  }

  .dispatch-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--ok);
    box-shadow: 0 0 0 0 rgba(127, 174, 139, 0.4);
    animation: dispatch-beat 2s infinite cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes dispatch-beat {
    0% { box-shadow: 0 0 0 0 rgba(127, 174, 139, 0.5); }
    70% { box-shadow: 0 0 0 8px rgba(127, 174, 139, 0); }
    100% { box-shadow: 0 0 0 0 rgba(127, 174, 139, 0); }
  }

  .dispatch-text {
    line-height: var(--leading-tight);
  }

  .dispatch-phone {
    color: var(--text-1);
    font-weight: var(--weight-semibold);
    font-variant-numeric: var(--font-variant-numeric-tabular);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .dispatch-phone:hover {
    color: var(--accent);
  }

  .domestic-hero__usp-bar {
    border-top: 1px solid var(--hairline);
    background-color: var(--surface-1);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .usp-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 640px) {
    .usp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .usp-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .usp-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .usp-item__icon-wrap {
    color: var(--ok);
    margin-top: 2px;
    flex-shrink: 0;
  }

  .usp-item__text-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .usp-item__label {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-1);
    line-height: var(--leading-tight);
  }

  .usp-item__sublabel {
    font-size: 0.75rem;
    color: var(--text-3);
    line-height: var(--leading-tight);
  }
</style>

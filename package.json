{
  "name": "website-factory",
  "version": "0.0.0",
  "private": true,
  "description": "Autonomous Website Factory monorepo: templates, shared packages and client sites.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=12.16.1"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "lint:anti-slop": "node factory/scripts/anti-slop-lint.mjs",
    "test": "pnpm -r --if-present run test && pnpm run test:factory",
    "test:factory": "node --test factory/scripts/anti-slop-lint.test.mjs factory/scripts/prompt-optimizer.test.mjs",
    "check": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run lint:anti-slop && pnpm run test",
    "factory:doctor": "node factory/scripts/doctor.mjs",
    "factory:prompt": "node factory/scripts/prompt-optimizer.mjs",
    "factory:smoke": "node factory/scripts/doctor.mjs && pnpm check"
  }
}
